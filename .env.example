# Modelo de configuração. NÃO edite este arquivo com senhas reais.
# Rode "make env": ele copia este modelo para .env e gera as três senhas.
# O .env fica fora do Git (veja .gitignore).

# --- Senhas (geradas pelo "make env") ---------------------------------------
# Atenção: as senhas do PostgreSQL e do ClickHouse só valem na PRIMEIRA subida,
# quando os volumes são criados. Trocar depois exige recriar os volumes
# (make limpar) ou alterar a senha dentro do banco.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
ZBX_ADMIN_PASSWORD=

# --- Imagens ----------------------------------------------------------------
# O compose.yaml já fixa cada imagem por digest (a da primeira subida que
# funcionou). Só descomente para trocar. Exemplo, voltar ao trunk do dia:
#   ZBX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:alpine-trunk
# Depois de testar uma imagem nova, pegue o digest com "make vm-digests".
#ZBX_SERVER_IMAGE=
#ZBX_WEB_IMAGE=
#ZBX_PROXY_IMAGE=
# ClickHouse precisa ser 26.8 ou mais novo (veja o comentário no compose.yaml).
#CLICKHOUSE_IMAGE=
#POSTGRES_IMAGE=
# Tag do servidor MCP (o digest fica fixo em compose.yaml; isto só troca a tag)
ZBX_TAG=alpine-trunk

# --- Rede -------------------------------------------------------------------
# 127.0.0.1 = só acessível de dentro da VM (use túnel SSH, veja o README).
# Só troque para 0.0.0.0 depois do "make bootstrap" (senha do Admin trocada) e
# com o security group liberando as portas apenas para o seu IP.
BIND_ADDR=127.0.0.1
ZBX_WEB_PORT=8080
MCP_PORT=8443
# OTLP e trapper: exceção deliberada (veja o README, seção "Infra"). As APIs
# fictícias e os 10 hosts simulados do WSL local (compose.local.yaml)
# precisam alcançar essas duas portas pela internet. "make vm-liberar-ip"
# abre as duas (e a 22) só para o seu IP atual.
ZBX_OTLP_BIND_ADDR=127.0.0.1
OTLP_PORT=4317
ZBX_TRAPPER_BIND_ADDR=127.0.0.1
ZBX_TRAPPER_PORT=10051

# --- IA: investigador de causa raiz (Gemini opcional) -----------------------
# Chave criada por VOCÊ em aistudio.google.com (Get API key). Cole aqui, no
# .env, NUNCA no chat/issue/commit. Vazia = modo "somente evidências" (padrão,
# nada é enviado ao Google). Lida só pelo container do investigador.
GEMINI_API_KEY=
# Modelos (confira em ai.google.dev/gemini-api/docs/models antes de trocar).
GEMINI_MODELO_PRE=gemini-3.5-flash-lite
GEMINI_MODELO_PROFUNDO=gemini-3.8-flash
# Controles de custo
INVESTIGADOR_ORCAMENTO_TOKENS_DIA=300000
INVESTIGADOR_MAX_LLM_HORA=20
INVESTIGADOR_MAX_APROFUNDAR_HORA=10
# Gerados pelo "make env" (não preencha à mão):
#   token compartilhado webhook/widget -> investigador
INVESTIGADOR_TOKEN=
#   senha do usuário readonly investigador_ro do ClickHouse
CLICKHOUSE_RO_PASSWORD=
#   token do ia-assistente legado (profile ia-legado)
IA_ASSISTENTE_TOKEN=
# Preenchido pelo "make investigador-config" (token de API do usuário
# svc-investigador: só leitura + comentário em problemas).
ZBX_INVESTIGADOR_TOKEN=
# Legado (ia-assistente): modelo e token de API do Zabbix
GEMINI_MODELO=gemini-3.5-flash-lite
ZBX_IA_API_TOKEN=

# --- Ajustes ----------------------------------------------------------------
ZBX_SERVER_NAME=Lab Zabbix 8 + OpenTelemetry
ZBX_PROXY_NAME=zabbix-proxy-otel
TZ_LAB=America/Sao_Paulo
# Memória máxima do ClickHouse (o maior consumidor do laboratório)
CLICKHOUSE_MEM=1280m
# Memória máxima do PostgreSQL. Não baixe de 1536m: a criação do banco na
# primeira subida manda o schema inteiro numa query só e estoura com 512m.
POSTGRES_MEM=1536m
# Intervalo entre ciclos do gerador de telemetria de teste, em segundos
GERADOR_INTERVALO_S=5
