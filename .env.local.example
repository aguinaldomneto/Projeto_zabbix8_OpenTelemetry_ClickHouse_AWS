# Modelo informativo do .env.local usado pelo compose.local.yaml (WSL local).
# Normalmente você não cria isso à mão: "make local-up" (scripts/subir-local.sh)
# descobre o IP público atual da VM e grava o .env.local sozinho, a cada vez
# (o IP muda sempre que a VM liga). Use este arquivo só se quiser pular essa
# descoberta automática e apontar para um IP fixo.

# IP público da VM da AWS (ou outro host) que roda o zabbix-proxy.
VM_IP=

# Chave SSH e usuário do túnel (serviço "tunel"): OTLP e trapper viajam por
# ele, e as portas 4317/10051 NUNCA são abertas na internet.
SSH_KEY=
SSH_USER=ubuntu

# Portas do zabbix-proxy dentro da VM (presas em 127.0.0.1, alcançadas pelo túnel).
OTLP_PORT=4317
ZBX_TRAPPER_PORT=10051

# Taxa do gerador de tráfego baseline (requisições por segundo).
TRAFEGO_REQ_S=3
