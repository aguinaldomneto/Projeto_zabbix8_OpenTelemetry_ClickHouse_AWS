<?xml version="1.0"?>
<!--
  Ajustes para rodar o ClickHouse em VM pequena de laboratório.
  O padrão do ClickHouse assume um servidor dedicado: reserva caches grandes e
  grava vários logs internos em tabelas system.*, que crescem em disco e RAM.
-->
<clickhouse>
    <!-- Usa no máximo 80% da memória que o container enxerga (mem_limit do Compose) -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- Caches reduzidos (bytes) -->
    <mark_cache_size>134217728</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <max_concurrent_queries>32</max_concurrent_queries>

    <!-- Logs internos que não usamos no laboratório -->
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>

    <!-- Logs mantidos para depurar, com retenção curta -->
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <!-- O proxy do Zabbix insere de forma assíncrona e não espera a resposta:
         se uma inserção falhar, o erro só aparece nesta tabela (make verificar). -->
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_insert_log>

    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
</clickhouse>
